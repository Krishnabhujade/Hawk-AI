# Copy to .env and edit. Every line is optional.

# Frontend URLs allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Replay: which past trading day to play back as "today" (YYYY-MM-DD).
# Empty = the latest full day in your data.
REPLAY_DATE=
# "live" = move through the day in step with the real clock (loops 09:15-15:30 all day)
# "HH:MM" = freeze the market at that time, e.g. 14:00
REPLAY_CLOCK=live

# Symbols shown in the Terminal watchlist (JSON list). NIFTY = the NIFTY 50 index.
WATCHLIST=["NIFTY","RELIANCE","HDFCBANK","INFY","TATAMOTORS","ICICIBANK"]

# Days of 1-minute data kept per symbol by the prepare step
KEEP_DAYS=7

# Prediction engine: "sample" until your model is ready, then "model"
PREDICTOR=sample
MODEL_PATH=models/hawk_model.joblib

# Paper trading: rupees per suggested position
PAPER_NOTIONAL=100000

# Login tokens. Leave empty to auto-generate one into data/.jwt_secret.
# DEPLOYING: set this to a long random string (32+ chars). A generated secret
# lives on disk, so on an ephemeral host it is lost on every restart and every
# user is signed out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# Demo account created on startup, for local development.
# DEPLOYING: set SEED_DEMO_USER=false. These credentials are published in the
# README, so leaving this on gives anyone a working login to your instance.
# The server logs a warning at startup if CORS_ORIGINS points somewhere public
# and either of these is still on its local default.
SEED_DEMO_USER=true
DEMO_EMAIL=demo@hawk.ai
DEMO_PASSWORD=hawk1234
